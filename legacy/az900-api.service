[Unit]
Description=AZ-900 progress backup API
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/az900-api/az900-api.py
Restart=on-failure
User=www-data
Group=www-data
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/az900-data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
